# Dependencies
**/node_modules/

# Next.js
**/.next/
**/out/

# Python
**/__pycache__/
**/*.py[cod]
.venv/
**/dist/
**/*.egg-info/

# Secrets & local env (never commit)
.env
.env.*
!.env.example
**/credentials/

# Session state (ref cache, pending refs, etc.)
**/.work/active-ref
**/.work/commit-ref-pending/*

# Scratch / temp trees
**/tmp/

# Vendored Agent OS copy (thin-client uses /mnt/work/Projects/.ai)
.ai/

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db

# Tooling / coverage (if added later)
coverage/
.nyc_output/

# TypeScript incremental build cache
**/tsconfig.tsbuildinfo
tsconfig.tsbuildinfo

# Next.js auto-generated (changes between dev/prod builds)
**/next-env.d.ts
