#  tools-project — copy to `.env` and adjust host ports / PUBLIC_HOST for your machine.
#
#  Docker Compose loads `.env` from the project root for `${...}` substitution in `docker-compose.yml`.
#  Do not commit `.env` if it contains secrets.
#
#  Change **PUBLIC_HOST** and **\*_HOST_PORT** first; the **PUBLIC\_*** URL lines below use them
#  (Compose interpolates `${PUBLIC_HOST}` etc. when you start the stack).

#  --- Stack identity ---
#  COMPOSE_PROJECT_NAME must be unique per clone if you run multiple stacks on one host.
#  It prefixes Compose containers/networks and the named volumes declared in docker-compose.yml.
#  Prefer ./bin/start.sh so every command uses this project + repo root explicitly.
STACK_ENV=dev
TD_APP_CODE=tpr
TD_STACK_SUFFIX=_dev_tpr
COMPOSE_PROJECT_NAME=tools_project_dev

#  --- Browser hostname (no scheme) — must match what users type / OAuth allows ---
#  Examples: localhost, 127.0.0.1, or a machine hostname on your LAN
PUBLIC_HOST=localhost

#  --- Host → container port mappings (published on your machine) ---
WEB_DEV_HOST_PORT=18513
API_HOST_PORT=8300
POSTGRES_HOST_PORT=55433

#  --- Derived public URLs (browser, OAuth redirect, CORS) — edit only if you need HTTPS edge / overrides ---
PUBLIC_ORIGIN=http://${PUBLIC_HOST}:${WEB_DEV_HOST_PORT}
NEXT_PUBLIC_API_BASE_URL=http://${PUBLIC_HOST}:${API_HOST_PORT}
OAUTH_REDIRECT_URI=http://${PUBLIC_HOST}:${WEB_DEV_HOST_PORT}/oauth/complete
CORS_ALLOWED_ORIGINS=http://${PUBLIC_HOST}:${WEB_DEV_HOST_PORT}

#  --- Auth modes ---
#  Standalone: AUTH_LOCAL_ENABLED=true, AUTH_OAUTH_ENABLED=false
#  Integrated (SSO): AUTH_LOCAL_ENABLED=false, AUTH_OAUTH_ENABLED=true
#  Hybrid: both true
AUTH_LOCAL_ENABLED=true
AUTH_OAUTH_ENABLED=true
JWT_SECRET=change_me_generate_a_long_random_secret_in_production
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=dev-bootstrap-change-me
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

#  --- OAuth (when AUTH_OAUTH_ENABLED=true) — register client in tools-dashboard ---
OAUTH_CLIENT_ID=project_t1p2r3j4
OAUTH_CLIENT_SECRET=change_me
OAUTH_TOKEN_ENDPOINT=https://dev.aiepic.app/oauth/token
# Used by the **API** (and web) — SSO access tokens are resolved to `users` rows via this URL.
OAUTH_USER_INFO_ENDPOINT=https://dev.aiepic.app/api/users/me
NEXT_PUBLIC_OAUTH_AUTHORIZATION_ENDPOINT=https://dev.aiepic.app/oauth/authorize
OAUTH_SCOPES="profile email"
SESSION_COOKIE_NAME=prj_auth
REFRESH_COOKIE_NAME=prj_refresh
# OAUTH_PKCE_STATE_SECRET=

#  --- Docker-internal only (service name `api`; internal listen port 8300 in Dockerfile.dev) ---
API_INTERNAL_URL=http://api:8300

#  --- Postgres ---
POSTGRES_USER=prj
POSTGRES_PASSWORD=prj_dev_change_me
POSTGRES_DB=tools_project
DATABASE_URL=postgresql://prj:prj_dev_change_me@postgresql:5432/tools_project
# Declarative schema (mounted ./sql:/sql in Compose for the api service)
# SQL_SCHEMA_DIR=/sql
# SQL_SCHEMA_APPLY=true

# API attachment files (Compose mounts named volume at /data/attachments by default)
# ATTACHMENTS_DIR=/data/attachments

# GitHub integration (optional): background poll + PAT encryption key (defaults to JWT_SECRET-derived key)
# GITHUB_SYNC_ENABLED=true
# GITHUB_POLL_INTERVAL_SECONDS=300
# GITHUB_POLL_INITIAL_DELAY_SECONDS=8
# GITHUB_COMMITS_PER_SYNC=100
# GITHUB_TOKEN_ENCRYPTION_KEY=
